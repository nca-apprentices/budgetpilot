#!/usr/bin/env bash
#MISE description="Generate the Xcode project from project.yml"
set -euo pipefail

# project.local.yml (not committed) includes project.yml and adds personal
# signing settings; use it when it exists so they survive regeneration.
if [ -f project.local.yml ]; then
  xcodegen generate --spec project.local.yml
else
  xcodegen generate
fi
