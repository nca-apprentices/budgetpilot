#!/usr/bin/env bash
#MISE description="Run unit tests on a simulator"
#MISE depends=["generate"]
set -euo pipefail

sim="$(scripts/pick-simulator.sh)"
# CI can't trust the MLX macro interactively in Xcode.
xcodebuild test -scheme BudgetPilot -destination "platform=iOS Simulator,name=$sim" -derivedDataPath .build -skipMacroValidation
